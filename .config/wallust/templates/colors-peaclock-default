# peaclock — default (wallust)
block 2 1
padding 0 0
margin 0 0
ratio 2 1
date-padding 1
fill ''
locale ''
timezone ''
date '%a %b %d'
mode clock
view digital
toggle active-bg
stopwatch start
timer 10m:0s
timer-exec 'notify-send -a peaclock "timer complete"'
rate-input 50
rate-refresh 1000
rate-status 5000
set hour-24 on
set seconds off
set date on
set auto-size on
set auto-ratio on
style active-fg {{background}}
style inactive-fg clear
style colon-fg {{color4}}
style active-bg {{color4}}
style inactive-bg {{background}}
style colon-bg clear
style date {{color6}}
style background {{background}}
style text {{foreground}}
style prompt clear
style success {{color2}}
style error {{color1}}
